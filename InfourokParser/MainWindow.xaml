<Window x:Class="InfourokParser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InfourokParser"
        mc:Ignorable="d"
        Title="MainWindow" Height="300" Width="450"
        ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Label Grid.Column="1" Content="Парсер Инфоурок" HorizontalAlignment="Center" FontSize="25"/>
        <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Введите ссылку" HorizontalAlignment="Center" />
            <TextBox Width="300" x:Name="urlSelect" Margin="5"/>
            <Label Content="Выберите тип выгружаемых данных: "/>
            <ComboBox x:Name="dataType" Margin="5,0,5,5" IsEnabled="False"/>
            <Button Height="25" x:Name="finishButton" Click="finishButton_Click" IsEnabled="True" Content="Выгрузить" Margin="5,0,5,0"/>
        </StackPanel>
    </Grid>
</Window>
